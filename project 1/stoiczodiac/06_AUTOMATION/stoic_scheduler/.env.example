# Instagram credentials (NEVER commit this file — keep it secret)
INSTAGRAM_USERNAME=stoiczodiac
INSTAGRAM_PASSWORD=your_password_here

# Optional: TOTP secret for automatic 2FA code generation
# Get this from Instagram Settings → Security → Two-Factor Authentication
INSTAGRAM_TOTP_SECRET=

# --- Meta Graph API (for carousels, reels, stories) ---
# You need: Professional IG account → linked Facebook Page → Meta app.
# See META_SETUP_GUIDE.md for step-by-step.
META_APP_ID=
META_APP_SECRET=
META_PAGE_ACCESS_TOKEN=
META_IG_USER_ID=

# --- Vercel Blob (media hosting for Meta API) ---
# Create a blob store in your Vercel dashboard → copy the RW token.
BLOB_READ_WRITE_TOKEN=